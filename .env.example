# Public API URL used by the frontend and packaged Electron app.
# LOCAL DEV: http://localhost:5000/api (backend running locally)
# PRODUCTION: https://sentra-api-test.onrender.com/api (or your prod backend URL)
VITE_API_URL=https://sentra-api-test.onrender.com/api

# Enables the Vite web build path for Render static hosting.
# LOCAL DEV: false (uses Vite dev server)
# PRODUCTION: true (optimized static build)
VITE_WEB=true

# Backend environment mode.
# LOCAL DEV: development
# PRODUCTION: production
APP_ENV=production

# Backend bind address.
HOST=0.0.0.0

# Backend port.
PORT=10000

# Public frontend URL allowed to call the backend.
CLIENT_URL=https://sentra.onrender.com

# MongoDB connection string.
MONGO_URI=mongodb+srv://appUser:U6JcYx6COJ1qkZQv@sentra.eu9yvd4.mongodb.net/?appName=Sentra

# MongoDB database name.
MONGO_DB_NAME=sentra

# MongoDB users collection.
MONGO_COLLECTION_USERS=users

# MongoDB files collection.
MONGO_COLLECTION_FILES=encrypted_files

# MongoDB recipients collection.
MONGO_COLLECTION_RECIPIENTS=recipients

# JWT signing secret.
JWT_SECRET_KEY=605067cb4fe5ac264bdedfe9753fdc21d685ac4e60ad3d807cbc6ed2125a011b

# App secret used by backend auth routines.
SECRET_KEY=605067cb4fe5ac264bdedfe9753fdc21d685ac4e60ad3d807cbc6ed2125a011b

# Password hashing rounds.
BCRYPT_ROUNDS=12

# Access token lifetime in hours.
TOKEN_EXPIRY_HOURS=24

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRY_DAYS=30

# Maximum upload size in bytes.
MAX_FILE_SIZE=104857600

# Backend log level.
LOG_LEVEL=INFO

# Backend log file path.
LOG_FILE=./logs/app.log

# Backend base directory used by the desktop shell.
BACKEND_BASE_DIR=./backend

# Backend data directory used by the desktop shell.
DATA_DIR=./backend/data

# Optional CORS allow-list fallback for local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000