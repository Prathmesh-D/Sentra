# Public API URL used by the frontend and packaged Electron app.
VITE_API_URL=https://your-backend.onrender.com/api

# Enables the Vite web build path for Render static hosting.
VITE_WEB=true

# Backend environment mode.
APP_ENV=production

# Backend bind address.
HOST=0.0.0.0

# Backend port.
PORT=10000

# Public frontend URL allowed to call the backend.
CLIENT_URL=https://your-frontend.onrender.com

# MongoDB connection string.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp

# MongoDB database name.
MONGO_DB_NAME=your_database_name

# MongoDB users collection.
MONGO_COLLECTION_USERS=users

# MongoDB files collection.
MONGO_COLLECTION_FILES=encrypted_files

# MongoDB recipients collection.
MONGO_COLLECTION_RECIPIENTS=recipients

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=replace-with-generated-secret

# App secret used by backend auth routines — use a different value from JWT_SECRET_KEY
SECRET_KEY=replace-with-generated-secret

# Password hashing rounds.
BCRYPT_ROUNDS=12

# Access token lifetime in hours.
TOKEN_EXPIRY_HOURS=24

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRY_DAYS=30

# Maximum upload size in bytes (100MB default).
MAX_FILE_SIZE=104857600

# Backend log level.
LOG_LEVEL=INFO

# Backend log file path.
LOG_FILE=./logs/app.log

# Backend base directory used by the desktop shell.
BACKEND_BASE_DIR=./backend

# Backend data directory used by the desktop shell.
DATA_DIR=./backend/data

# Optional CORS allow-list fallback for local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000